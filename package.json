{
  "name": "vean-ui-adapter",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "cleanup": "soy cleanup",
    "commit": "soy git-commit",
    "dev": "vp pack --watch",
    "fmt": "vp fmt",
    "lint": "vp lint --fix && pnpm lint:vue",
    "lint:vue": "eslint . --ext .vue --fix",
    "play": "vp dev",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "@vean/ui": "^0.50.2"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.5",
    "@vean/unocss": "^0.50.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "typescript": "catalog:",
    "unocss": "^66.11.0",
    "unplugin-vue": "^8.0.0",
    "unplugin-vue-jsx": "^0.10.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
